{
  "name": "codex-commit-message",
  "displayName": "Codex Commit Message",
  "description": "Generate a commit message from staged changes with your local Codex CLI.",
  "version": "0.1.2",
  "icon": "images/icon.png",
  "publisher": "libsrcdev",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["SCM Providers"],
  "main": "./extension.js",
  "extensionKind": ["workspace"],
  "extensionDependencies": ["vscode.git"],
  "capabilities": { "untrustedWorkspaces": { "supported": false }, "virtualWorkspaces": false },
  "contributes": {
    "commands": [{ "command": "codexCommit.generate", "title": "Codex: Generate Commit Message", "icon": "$(sparkle)" }],
    "menus": {
      "scm/title": [{ "command": "codexCommit.generate", "when": "scmProvider == git", "group": "navigation" }],
      "scm/inputBox": [{ "command": "codexCommit.generate", "when": "scmProvider == git", "group": "navigation" }]
    },
    "configuration": {
      "title": "Codex Commit Message",
      "properties": {
        "codexCommit.executable": { "type": "string", "default": "", "scope": "machine", "description": "Codex executable path. Empty uses the installed OpenAI extension, then PATH." },
        "codexCommit.model": { "type": "string", "default": "", "description": "Optional Codex model. Empty uses the CLI default." },
        "codexCommit.conventionalCommits": { "type": "boolean", "default": true, "description": "Use Conventional Commits (feat:, fix:, etc.)." },
        "codexCommit.language": { "type": "string", "default": "English", "description": "Language for generated messages." },
        "codexCommit.maxDiffChars": { "type": "integer", "default": 12000, "minimum": 1000, "maximum": 50000, "description": "Maximum characters of compact diff sent to Codex. Smaller values save tokens but omit more detail." },
        "codexCommit.reasoningEffort": { "type": "string", "enum": ["low", "medium", "high", "default"], "default": "low", "description": "Low saves reasoning tokens. Select default if your chosen model does not support low." }
      }
    }
  },
  "scripts": { "test": "node --test test/*.test.js" },
  "license": "MIT"
}
